{
  "name": "cucumber-json-report-formatter",
  "version": "1.0.2",
  "description": "Cucumber report formatter for @badeball/cypress-cucumber-preprocessor report",
  "license": "MIT",
  "author": "Vitalii Rymar",
  "main": "./lib/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "commonjs",
  "keywords": [
    "cucumber",
    "formatter",
    "report",
    "bdd",
    "automation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/vrymar/cucumber-json-report-formatter.git"
  },
  "bugs": {
    "url": "https://github.com/vrymar/cucumber-json-report-formatter/issues"
  },
  "homepage": "https://github.com/vrymar/cucumber-json-report-formatter/#readme",
  "scripts": {
    "prepare": "npm run build",
    "prepublishOnly": "npm run eslint",
    "build": "rimraf lib && tsc",
    "eslint": "oxlint ./src",
    "test": "npm run build && node --test src/tests/formatter.spec.js src/tests/formatter.unit.spec.js"
  },
  "files": [
    "lib/**/*"
  ],
  "dependencies": {
    "jsonschema": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxlint": "^1.88.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
