{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "lib",
    "types": ["node"],
    "declaration": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "strict": true,
    "target": "esnext",
    "module": "CommonJS",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "lib": [
			"esnext"
		],
    "pretty": true,
    "stripInternal": true,
		"newLine": "lf",
    "skipLibCheck": true
  },
  "include": [
    "./src/**/*.ts",
    "./src/**/*.json"
  ],
  "exclude": [
    "node_modules",
    "src/tests"
  ]
}
